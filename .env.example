# GEMINI_API_KEY: Required for Gemini AI API calls (AI Chatbot, Lead Qualification, Indian Language Support).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC signing secret for JWT authentication tokens (32+ chars in production).
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET"

# WHATSAPP_VERIFY_TOKEN & WHATSAPP_ACCESS_TOKEN: Meta WhatsApp Cloud API credentials (optional for live webhook).
WHATSAPP_VERIFY_TOKEN="MY_WHATSAPP_WEBHOOK_VERIFY_TOKEN"
WHATSAPP_ACCESS_TOKEN="MY_META_CLOUD_API_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"

# POSTGRESQL CONNECTION (Production PostgreSQL / Cloud SQL target)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="avasa_realty_crm"
SQL_USER="crm_app_user"
SQL_PASSWORD="CHANGE_ME_APP_PASSWORD"
SQL_ADMIN_USER="crm_admin_user"
SQL_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"
